# ============================================================================
# LexGuard environment variables (example). Copy to .env and fill real values.
# Never commit a real .env file.
# ============================================================================

# --- GCP project ---
GCP_PROJECT_ID=your-gcp-project-id
GCP_REGION=asia-south1
GCP_SERVICE_ACCOUNT_EMAIL=lexguard-runner@your-gcp-project-id.iam.gserviceaccount.com

# --- Vertex AI ---
VERTEX_LOCATION=us-central1
VERTEX_MODEL_PRO=gemini-2.5-pro
VERTEX_MODEL_FLASH=gemini-2.5-flash

# --- Firestore ---
FIRESTORE_DATABASE=(default)
FIRESTORE_COLLECTION_DOCUMENTS=documents
FIRESTORE_COLLECTION_ANALYSES=analyses

# --- Cloud Storage ---
GCS_UPLOAD_BUCKET=lexguard-uploads
GCS_REPORTS_BUCKET=lexguard-reports

# --- Document AI ---
DOCAI_PROCESSOR_ID=
DOCAI_LOCATION=us

# --- Firebase Auth (frontend) ---
NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=
NEXT_PUBLIC_FIREBASE_PROJECT_ID=

# --- API ---
API_BASE_URL=http://localhost:8000
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000
ALLOWED_ORIGINS=http://localhost:3000
LOG_LEVEL=INFO
ENVIRONMENT=development
